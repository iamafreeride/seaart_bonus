# Required — copy the whole Cookie request header from a logged-in browser.
# DevTools → Network → any request to www.seaart.ai → Request Headers → cookie
SEAART_COOKIE=

# Required — the exact User-Agent of the browser that minted the cookie.
SEAART_USER_AGENT=

# Optional
SEAART_LOCALE=zhTW
SEAART_HEADLESS=true
SEAART_SETTLE_MS=2500
SEAART_TIMEOUT_MS=45000
SEAART_SLOW_MO=0

# Task surfaces (defaults are the two required pages)
SEAART_CHECKIN_URL=https://www.seaart.ai/zhTW/battlePass
SEAART_GIFT_URL=https://www.seaart.ai/zhTW/mall?dotFrom=svip_banner

# Calibration (only needed when the site labels change)
# SEAART_CHECKIN_ENTRY=
# SEAART_GIFT_ENTRY=
# SEAART_CLAIM_BUTTON=
SEAART_DUMP_DIR=./dump
