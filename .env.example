# ===========================================================================
#  SeaArt AI 每日簽到 / 每日禮盒
#  Copy this file to .env and fill in the values. NEVER commit the real .env.
# ===========================================================================

# --- Account 1 (required) --------------------------------------------------
# DevTools -> Network -> any request to www.seaart.ai -> Request Headers -> cookie
SEAART_COOKIE=paste_the_whole_cookie_header_here
# The user agent of the SAME browser session that produced the cookie.
SEAART_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36

# --- Account 2 (optional) --------------------------------------------------
# SEAART_COOKIE_2=
# SEAART_USER_AGENT_2=

# --- Behaviour -------------------------------------------------------------
# SEAART_LOCALE=zhTW
# SEAART_TIMEOUT=30
# SEAART_DRY_RUN=false
# SEAART_VERBOSE=false
